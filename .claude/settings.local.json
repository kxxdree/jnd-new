{
  "permissions": {
    "allow": [
      "PowerShell(node -v)",
      "PowerShell(npm -v)",
      "PowerShell(npm install nuxt@^4 vue vue-router leaflet qrcode)",
      "PowerShell(npm install -D tailwindcss @tailwindcss/vite @types/leaflet @types/qrcode)",
      "PowerShell($env:PORT='3123'; node .output/server/index.mjs)",
      "Bash(curl -s -o /dev/null -w '%{http_code} %{redirect_url} %{time_total}s\\\\n' \"https://loremflickr.com/900/700/cocktail,bar?lock=11\")",
      "Bash(curl -sL -o /dev/null -w '%{http_code} %{content_type} %{time_total}s\\\\n' \"https://loremflickr.com/900/700/cocktail,bar?lock=11\")",
      "Bash(curl -sL -o /dev/null -w 'picsum %{http_code} %{content_type} %{time_total}s\\\\n' \"https://picsum.photos/seed/joined11/900/700\")"
    ]
  }
}
